NODE_ENV=development
# Only used as a fallback — `npm run start`/`start:dev` set WORKER_NAME=all
# themselves (runs every worker in one process, handy for local dev).
# `npm run start:<name>` overrides this to run just that one worker.
WORKER_NAME=email
QUEUE_PROVIDER=rabbitmq
RABBITMQ_URL=amqp://donate:donate@localhost:5672
RABBITMQ_EXCHANGE=donate.jobs
RABBITMQ_RETRY_EXCHANGE=donate.retry
RABBITMQ_DLX_EXCHANGE=donate.dlx

EMAIL_QUEUE_NAME=email.send
EMAIL_DLQ_NAME=email.send.dlq
EMAIL_MAX_ATTEMPTS=5
EMAIL_RETRY_INITIAL_DELAY_MS=1000
EMAIL_RETRY_MAX_DELAY_MS=60000
EMAIL_RETRY_MULTIPLIER=2
EMAIL_RETRY_JITTER_RATIO=0.2

EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@elodoar.local
RESEND_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Shared retry policy for stripe-webhook/receipt-generate/notification-push
# (email.send keeps its own EMAIL_RETRY_* policy above).
QUEUE_MAX_ATTEMPTS=5
QUEUE_RETRY_INITIAL_DELAY_MS=1000
QUEUE_RETRY_MAX_DELAY_MS=60000
QUEUE_RETRY_MULTIPLIER=2
QUEUE_RETRY_JITTER_RATIO=0.2

STRIPE_WEBHOOK_QUEUE_NAME=stripe.webhook
STRIPE_WEBHOOK_DLQ_NAME=stripe.webhook.dlq
RECEIPT_GENERATE_QUEUE_NAME=receipt.generate
RECEIPT_GENERATE_DLQ_NAME=receipt.generate.dlq
NOTIFICATION_PUSH_QUEUE_NAME=notification.push
NOTIFICATION_PUSH_DLQ_NAME=notification.push.dlq

# Idempotency store for all workers — "redis" survives restarts and works
# across replicas; "memory" is a per-process Set, dev/single-instance only.
IDEMPOTENCY_PROVIDER=redis
IDEMPOTENCY_TTL_MS=86400000
# Same Redis instance donate-server uses (donate-infra Docker locally, or
# the same Upstash instance in production).
REDIS_URL=redis://:donate@localhost:6379
REDIS_KEY_PREFIX=donate:

# Must point at the SAME database donate-server uses — stripe-webhook and
# receipt-generate read/write donate-server's own collections.
MONGODB_URI=
MONGODB_CLUSTER_URI=mongodb://localhost:27017
MONGODB_DATABASE=test

# Must match donate-server's JWT_SECRET exactly — only used to sign/verify
# the receipt PDF download token (no auth surface of its own).
JWT_SECRET=change-me

STRIPE_SECRET_KEY=
STRIPE_CURRENCY=brl
STRIPE_SERVICE_FEE_BPS=0

# receipt-generate's PDF storage. Must match donate-server's S3_* values
# exactly — donate-workers writes the PDF here, donate-server reads it back
# to generate the signed download URL. With OBJECT_STORAGE_DRIVER=local
# instead, this writes to <cwd>/storage/<key> on whatever machine runs
# donate-workers, which only works if both processes share that
# path/volume — S3 avoids that entirely.
OBJECT_STORAGE_DRIVER=s3
OBJECT_STORAGE_SIGNED_URL_TTL_SECONDS=300
S3_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# notification-push (FCM)
FCM_ENABLED=true
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Branded HTML template for the donation-receipt email (moved with
# receipt-generate) — same defaults as donate-server's EMAIL_* vars.
EMAIL_BRAND_LOGO_URL=
EMAIL_BRAND_HERO_URL=
EMAIL_PUBLIC_APP_URL=
EMAIL_SUPPORT_EMAIL=contato@elodoar.local
EMAIL_SUPPORT_PHONE=

# notification-digest (weekly email summary) — only runs when
# WORKER_NAME=digest. Cron syntax: minute hour day month weekday.
DIGEST_CRON_EXPRESSION=0 9 * * 1
