NODE_ENV=development
WORKER_NAME=email
QUEUE_PROVIDER=rabbitmq
RABBITMQ_URL=amqp://donate:donate@localhost:5672
RABBITMQ_EXCHANGE=donate.jobs
RABBITMQ_RETRY_EXCHANGE=donate.retry
RABBITMQ_DLX_EXCHANGE=donate.dlx

EMAIL_QUEUE_NAME=email.send
EMAIL_DLQ_NAME=email.send.dlq
EMAIL_MAX_ATTEMPTS=5
EMAIL_RETRY_INITIAL_DELAY_MS=1000
EMAIL_RETRY_MAX_DELAY_MS=60000
EMAIL_RETRY_MULTIPLIER=2
EMAIL_RETRY_JITTER_RATIO=0.2

EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@elodoar.local
RESEND_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
